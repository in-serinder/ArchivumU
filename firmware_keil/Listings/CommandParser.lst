 458   2          if (key_off == 0xFFFF) { CMD_Reply("ERR", ERR_DATA_FULL); return ERR_DATA_FULL; }
 459   2          { uint16_t i; for (i = 0; i < key_len; i++)
 460   3              EEPROM_WriteByte((uint16_t)(key_off + i), (uint8_t)key[i]); }
 461   2          e.enc_algo = ENC_ALGO_NONE;
 462   2          e.flags    = KV_FLAG_VALID;
 463   2        } else {
 464   2          /* 更新：读旧索引项，等长就地覆写，否则删旧+追新 */
 465   2          CMD_ReadKvEntry(idx, &e);
 466   2          if (e.data_len == val_len && CMD_UpdateKvRecordValue(e.data_addr, value, val_len)) {
 467   3            return ERR_OK;
 468   3          }
 469   2          key_off = e.key_off;
 470   2          if (e.flags & KV_FLAG_VALID) CMD_DeleteKvRecord(e.data_addr);
 471   2        }
 472   1      
 473   1        data_addr = CMD_AppendKvRecord(blk->block_id, key, value, val_len,
 474   1                                       e.enc_algo, KV_FLAG_VALID);
 475   1        if (data_addr == 0xFFFF) { CMD_Reply("ERR", ERR_DATA_FULL); return ERR_DATA_FULL; }
 476   1      
 477   1        e.block_id  = blk->block_id;
 478   1        e.key_len   = key_len;
 479   1        e.key_off   = key_off;
 480   1        e.slave     = IC_1_24CXX;
 481   1        e.data_addr = data_addr;
 482   1        e.data_len  = val_len;
 483   1        EEPROM_SetAddress(IC_0_24C64);
 484   1        CMD_WriteKvEntry(kv_slot, &e);
 485   1        if (idx == 0xFFFF) {
 486   2          blk->kv_count = (uint16_t)(blk->kv_count + 1);
 487   2          CMD_WriteBlockSlot(blk_slot, blk);
 488   2        }
C51 COMPILER V9.59.0.0   COMMANDPARSER                                                     09/30/2026 23:25:46 PAGE 9   

 489   1        return ERR_OK;
 490   1      }
