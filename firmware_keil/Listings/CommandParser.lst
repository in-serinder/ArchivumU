 412           * 否则删除旧记录、追加新记录并回写索引。成功返回 1。 */
 413          static uint8_t CMD_UpsertKeyValue(uint16_t idx, block_entry_t *blk,
 414                                            const char *key,
 415                                            const uint8_t *value, uint16_t val_len) {
 416   1        kv_entry_t e;
 417   1        CMD_ReadKvEntry(idx, &e);
 418   1        if (e.data_len == val_len) {
 419   2          CMD_UpdateKvRecordValue(e.data_addr, value, val_len);
 420   2          return 1;
 421   2        }
 422   1        {
 423   2          uint16_t new_addr;
 424   2          CMD_DeleteKvRecord(e.data_addr);
 425   2          EEPROM_SetAddress(IC_0_24C64);
 426   2          new_addr = CMD_AppendKvRecord(blk->block_id, key, value, val_len,
C51 COMPILER V9.59.0.0   COMMANDPARSER                                                     09/26/2026 13:07:36 PAGE 8   

 427   2                                        e.enc_algo, KV_FLAG_VALID);
 428   2          if (new_addr == 0xFFFF) return 0;
 429   2          e.data_addr = new_addr;
 430   2          e.data_len  = val_len;
 431   2          e.slave     = IC_1_24CXX;
 432   2          EEPROM_SetAddress(IC_0_24C64);
 433   2          CMD_WriteKvEntry(idx, &e);
 434   2        }
 435   1        return 1;
 436   1      }
