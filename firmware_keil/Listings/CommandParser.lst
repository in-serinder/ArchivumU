 492          static uint8_t CMD_DoCreateBlock(char *name) {
 493   1        block_entry_t blk;
 494   1        uint16_t slot;
 495   1        if (name == 0 || strlen(name) == 0) { CMD_Reply("ERR", ERR_PARAM); return 0; }
 496   1        if (CMD_BlockNameExists(name)) { CMD_Reply("ERR", ERR_BLOCK_EXIST); return 0; }
 497   1        slot = CMD_FindFreeBlockSlot();
