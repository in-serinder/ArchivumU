 501          static void CMD_EmitBlockKv(uint16_t block_id) {
 502   1        uint16_t i, count = 0;
 503   1        for (i = 0; i < KVIDX_MAX; i++) {
 504   2          kv_entry_t e;
 505   2          uint16_t k, val_len;
 506   2          CMD_ReadKvEntry(i, &e);
 507   2          if (e.block_id != block_id) continue;
 508   2          if (!(e.flags & KV_FLAG_VALID)) continue;
 509   2          if (count > 0) Uart1_SendString(",");
 510   2          for (k = 0; k < e.key_len; k++)
 511   2            Uart1_SendByte(EEPROM_ReadByte((uint16_t)(e.key_off + k)));
 512   2          Uart1_SendString("=");
 513   2          EEPROM_SetAddress(e.slave);
 514   2          val_len = CMD_ReadU16((uint16_t)(e.data_addr + KV_OFF_VAL_LEN));
 515   2          {
 516   3            uint16_t key_len = CMD_ReadU16((uint16_t)(e.data_addr + KV_OFF_KEY_LEN));
 517   3            for (k = 0; k < val_len; k++)
 518   3              Uart1_SendByte(EEPROM_ReadByte((uint16_t)(e.data_addr + KV_OFF_KEY + key_len + k)));
 519   3          }
 520   2          count++;
 521   2        }
 522   1      }
 523          
 524          static void CMD_EmitBlockEntry(block_entry_t *blk) {
 525   1        char name[BLOCK_NAME_LEN + 1];
 526   1        CMD_GetBlockName(blk, name);
 527   1        Uart1_SendString("[");
 528   1        Uart1_SendString(name);
 529   1        Uart1_SendString(";");
 530   1        Uart1_SendNumber(blk->block_id);
 531   1        Uart1_SendString("](");
 532   1        CMD_EmitBlockKv(blk->block_id);
 533   1        Uart1_SendString(")");
 534   1      }
 535          
 536          static void CMD_PurgeBlockKv(uint16_t block_id) {
 537   1        uint16_t i;
 538   1        for (i = 0; i < KVIDX_MAX; i++) {
 539   2          kv_entry_t e;
 540   2          CMD_ReadKvEntry(i, &e);
 541   2          if (e.block_id != block_id) continue;
 542   2          if (e.flags & KV_FLAG_VALID) CMD_DeleteKvRecord(e.data_addr);
 543   2          EEPROM_SetAddress(IC_0_24C64);
 544   2          CMD_WriteU16(CMD_KvEntryOff(i), 0xFFFF);
 545   2        }
 546   1      }
 547          
 548          static void CMD_EmitAllBlocks(void) {
 549   1        block_entry_t blk;
 550   1        uint16_t i, n = 0;
C51 COMPILER V9.59.0.0   COMMANDPARSER                                                     09/26/2026 13:07:36 PAGE 10  

 551   1        Uart1_SendString("DATA+");
 552   1        for (i = 0; i < BLOCK_TAB_MAX; i++) {
 553   2          if (!CMD_ReadBlockSlot(i, &blk)) continue;
 554   2          if (n > 0) Uart1_SendString("|");
 555   2          CMD_EmitBlockEntry(&blk);
 556   2          n++;
 557   2        }
 558   1        Uart1_SendString("\r\n");
 559   1      }
