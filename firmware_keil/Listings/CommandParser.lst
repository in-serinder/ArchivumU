 440          /* 统一的 KV 写入：idx==0xFFFF 表示新建（分配槽位/键池，kv_count+1），
 441           * 否则更新既有槽位（等长原地覆写，否则删旧记录+追新记录+回写索引）。
 442           * 成功返回 ERR_OK；已回带 ERR 应答。 */
 443          static uint8_t CMD_PutKeyValue(block_entry_t *blk, uint16_t blk_slot,
 444                                         uint16_t idx, const char *key,
 445                                         const uint8_t *value, uint16_t val_len) {
 446   1        kv_entry_t e;
 447   1        uint16_t key_len = (uint16_t)strlen(key);
 448   1        uint16_t kv_slot = idx, key_off, data_addr;
 449   1      
 450   1        if (key_len == 0) { CMD_Reply("ERR", ERR_PARAM); return ERR_PARAM; }
 451   1      
 452   1        if (idx == 0xFFFF) {
 453   2          /* 新建：分配索引槽 + 键池空间 */
 454   2          kv_slot = CMD_AllocKvSlot();
 455   2          if (kv_slot == 0xFFFF) { CMD_Reply("ERR", ERR_BITMAP_FULL); return ERR_BITMAP_FULL; }
 456   2          EEPROM_SetAddress(IC_0_24C64);
