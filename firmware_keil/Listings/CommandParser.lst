 520   1        if (CMD_FindKeyIdx(blk.block_id, key) != 0xFFFF) { CMD_Reply("ERR", ERR_KEY_EXIST); return 0; }
 521   1        return (CMD_PutKeyValue(&blk, slot, 0xFFFF, key, (const uint8_t *)value, val_len) == ERR_OK);
