 489   1        e.slave     = IC_1_24CXX;
 490   1        e.data_addr = data_addr;
 491   1        e.data_len  = val_len;
 492   1        e.enc_algo  = ENC_ALGO_NONE;
 493   1        e.flags     = KV_FLAG_VALID;
 494   1        EEPROM_SetAddress(IC_0_24C64);
 495   1        CMD_WriteKvEntry(kv_slot, &e);
