 129          // CMD_INIT: AT+INIT+<设备名>+<密码(UPASS表示不启用密码)>+<加密方式(0不加密/1AES/2XOR/3
             -凯撒/4RC4)>
 130          void CMD_INIT(char *device_name, char *password, uint8_t encrypt_type) {
 131   1        // 导航路径: 起始 -> 设备初始化
 132   1        uint8_t i;
 133   1        uint8_t ch;
 134   1        uint8_t name_len;
 135   1        uint8_t hash[16];                    /* BLAKE2s输出16字节 */
 136   1        uint8_t flags = FLAG_INITIALIZED;    /* bit0: 设备已初始化 */
 137   1        uint8_t checksum = 0;
 138   1        bit enablePassword;                  /* 密码非空且非"UPASS"才启用 */
 139   1      
 140   1        enablePassword = (strlen(password) > 0) && (!CMD_Compare(password, PASS_NONE_STR));
 141   1      
 142   1        if (enablePassword) flags |= FLAG_PWD_AUTH;              /* bit3: 密码鉴权功能启用 */
 143   1        if (encrypt_type != ENC_NONE) flags |= FLAG_FILE_ENCRYPT; /* bit4: 文件加密功能启用 */
 144   1      
 145   1        // 对EEPROM全部写入0x00 初始化状态标志 (整片8KB清零)
 146   1        EEPROM_SetAddress(IC_0_24C64);
 147   1        DM_format_block(DEV_EEPROM_SIZE, 0x00);
 148   1      
 149   1        // 0x01: 状态标志位
 150   1        EEPROM_WriteByte(CFG_ADDR_FLAGS, flags);
 151   1        checksum ^= flags;
 152   1      
 153   1        // 0x02~0x11: 密码哈希(BLAKE2s输出16字节, 0x12~0x21 保持0x00)
 154   1        if (enablePassword) {
 155   2          BLAKE2s_Checksum(password, (uint8_t)strlen(password), hash);
 156   2          for (i = 0; i < 16; i++) {
 157   3            EEPROM_WriteByte(CFG_ADDR_PWD_HASH + i, hash[i]);
 158   3            checksum ^= hash[i];
 159   3          }
 160   2        }
 161   1      
 162   1        // 0x3C~0x4D: 设备名称(18字节, 不足补0x00)
 163   1        name_len = (uint8_t)strlen(device_name);
 164   1        if (name_len > CFG_NAME_LEN) name_len = CFG_NAME_LEN;
 165   1        for (i = 0; i < CFG_NAME_LEN; i++) {
 166   2          ch = (i < name_len) ? (uint8_t)device_name[i] : 0x00;
 167   2          EEPROM_WriteByte(CFG_ADDR_NAME + i, ch);
 168   2          checksum ^= ch;
 169   2        }
 170   1      
 171   1        // 0x4E: 加密方式
 172   1        EEPROM_WriteByte(CFG_ADDR_ENCRYPT, encrypt_type);
 173   1        checksum ^= encrypt_type;
 174   1      
 175   1        // 0x4F: 键值对数量, 0x50: 设备大小
 176   1        EEPROM_WriteByte(CFG_ADDR_KEY_VOL, KEY_VOL_DEFAULT);
C51 COMPILER V9.59.0.0   COMMANDPARSER                                                     08/03/2026 02:39:21 PAGE 4   

 177   1        EEPROM_WriteByte(CFG_ADDR_DEV_SIZE, DEV_SIZE_DEFAULT);
