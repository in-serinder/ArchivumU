 479   1        { uint16_t i; for (i = 0; i < key_len; i++)
 480   2            EEPROM_WriteByte((uint16_t)(key_off + i), (uint8_t)key[i]); }
 481   1      
 482   1        data_addr = CMD_AppendKvRecord(blk.block_id, key, (const uint8_t *)value,
 483   1                                       val_len, ENC_ALGO_NONE, KV_FLAG_VALID);
 484   1        if (data_addr == 0xFFFF) { CMD_Reply("ERR", ERR_DATA_FULL); return 0; }
 485   1      
 486   1        e.block_id  = blk.block_id;
 487   1        e.key_len   = key_len;
 488   1        e.key_off   = key_off;
