 524          static void CMD_EmitBlockKv(uint16_t block_id) {
 525   1        uint16_t i, count = 0;
 526   1        for (i = 0; i < KVIDX_MAX; i++) {
 527   2          kv_entry_t e;
 528   2          uint16_t k, val_len, key_len;
 529   2          CMD_ReadKvEntry(i, &e);
 530   2          if (e.block_id != block_id) continue;
 531   2          if (!(e.flags & KV_FLAG_VALID)) continue;
 532   2          if (count > 0) Uart1_SendString(",");
 533   2          for (k = 0; k < e.key_len; k++)
 534   2            Uart1_SendByte(EEPROM_ReadByte((uint16_t)(e.key_off + k)));
 535   2          Uart1_SendString("=");
 536   2          key_len = CMD_ReadKvRecordLens(e.data_addr, &val_len);
 537   2          if (key_len == 0xFFFF) { count++; continue; }
 538   2          for (k = 0; k < val_len; k++)
 539   2            Uart1_SendByte(EEPROM_ReadByte((uint16_t)(e.data_addr + KV_OFF_KEY + key_len + k)));
 540   2          count++;
 541   2        }
 542   1      }
