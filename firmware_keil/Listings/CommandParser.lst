 468   1        slot = CMD_ResolveBlock(block_flag, block_identifier, &blk);
 469   1        if (slot == 0xFFFF) { CMD_Reply("ERR", ERR_BLOCK_NOT_FOUND); return 0; }
 470   1        if (CMD_FindKeyIdx(blk.block_id, key) != 0xFFFF) { CMD_Reply("ERR", ERR_KEY_EXIST); return 0; }
 471   1        if (key_len == 0) { CMD_Reply("ERR", ERR_PARAM); return 0; }
 472   1      
 473   1        kv_slot = CMD_AllocKvSlot();
