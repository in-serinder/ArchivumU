  13          /* 接入计数 +1 (0x22~0x23 : 2 Byte uint16 大端存储, 最大65535封顶) */
  14          void DM_UPDATECOUNT_Add(void) {
  15   1          uint16_t count = ((uint16_t)EEPROM_ReadByte(CFG_ADDR_ACCESS_CNT) << 8) |
  16   1                           (uint16_t)EEPROM_ReadByte(CFG_ADDR_ACCESS_CNT + 1);
  17   1      
  18   1          if (count < 0xFFFF) count++;   /* 达到65535后不再自增, 避免溢出回绕 */
  19   1      
  20   1          EEPROM_WriteByte(CFG_ADDR_ACCESS_CNT,     (uint8_t)(count >> 8));    /* 高字节(0x22) */
  21   1          EEPROM_WriteByte(CFG_ADDR_ACCESS_CNT + 1, (uint8_t)(count & 0xFF));  /* 低字节(0x23) */
  22   1      }
  23          
  24          /* 读取接入计数 (0x22~0x23 : 2 Byte uint16 大端) */
  25          uint16_t DM_UPDATECOUNT_Get(void) {
  26   1          return ((uint16_t)EEPROM_ReadByte(CFG_ADDR_ACCESS_CNT) << 8) |
  27   1                 (uint16_t)EEPROM_ReadByte(CFG_ADDR_ACCESS_CNT + 1);
  28   1      }


