  73   1          I2C_SendByte(dat);             if (I2C_WaitAck()) { I2C_Err = 4; I2C_Stop(); return; }
  74   1          I2C_Stop();
  75   1          DelayMs(5);  // 24C64 tWR = 5ms
  76   1      }
