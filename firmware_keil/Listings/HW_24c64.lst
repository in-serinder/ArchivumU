  17          /* STC8G 硬件I2C寄存器要点:
  18             - I2CCFG (FE80H):  BIT7=ENI2C  BIT6=MSSL  [5:0]=MSSPEED
  19             - I2CMSST(FE82H):  BIT6=MSIF   BIT1=MSACKI BIT0=MSACKO
  20             - I2CMSCR(FE83H):  CMD=1 START, 2 SEND, 3 RECVACK, 4 RECV, 5 ACK, 6 STOP
  21             - P_SW2 (0BAH):    BIT7=EAXFR  BIT5:4=I2C_S 引脚选择
  22             - 主频 22.1184MHz, MSSPEED=25 → I2C总线≈205KHz ≤24C64 400KHz极限
  23          */
  24          
  25          #define I2C_MSSPEED  25
  26          
  27          static void I2C_Wait(void)
  28          {
  29   1          while (!(I2CMSST & 0x40));   // 轮询 MSIF=BIT6
  30   1          I2CMSST &= ~0x40;              // 软件清0
  31   1      }
