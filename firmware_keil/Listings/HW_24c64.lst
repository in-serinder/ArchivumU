  33          /* I2C主机初始化:
  34             - P3.2=SCL P3.3=SDA (准双向口)
  35             - P5.4/P5.5=WP#0/WP#1 (推挽输出, 拉低=允许写)
  36             - P_SW2.EAXFR=1 开放扩展SFR访问
  37          */
  38          void I2C_Init(void)
  39          {
  40   1          P3M1 &= ~0x0C;   P3M0 &= ~0x0C;   // P3.2/P3.3: 准双向
  41   1          P5M1 &= ~0x30;   P5M0 |=  0x30;   // P5.4/P5.5 (WP): 推挽输出
  42   1          IC0_WP = 0;                        // WP低 = 解除24C64写保护
  43   1          IC1_WP = 0;
  44   1          P_SW2 |= 0x80;                     // EAXFR=1 访问扩展SFR
  45   1          I2CCFG  = 0xE0 | I2C_MSSPEED;     // ENI2C=1 MSSL=1(主机)
  46   1          I2CMSST = 0x00;                     // 清状态
  47   1      }
  48          
  49          void I2C_Start(void)  { I2CMSCR = 0x01; I2C_Wait(); }   // CMD1: START
  50          void I2C_Stop(void)   { I2CMSCR = 0x06; I2C_Wait(); }   // CMD6: STOP
  51          void I2C_SendByte(uint8_t byte) { I2CTXD = byte; I2CMSCR = 0x02; I2C_Wait(); }   // CMD2: SEND
  52          uint8_t I2C_ReceiveByte(void)   { I2CMSCR = 0x04; I2C_Wait(); return I2CRXD; }        // CMD4: RECV
  53          
