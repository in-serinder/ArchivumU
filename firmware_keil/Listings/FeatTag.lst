   3          /* FeatTag —— 中等安全强度的紧凑特征算法
   4           * ------------------------------------------------------------------
   5           * 设计目标: 在8051(8位, 代码区受限)上以极小代码量提供"优于简单异或"
   6           *           的口令/配置校验能力。非密码学安全哈希, 但对短口令的抗碰撞、
   7           *           抗篡改能力明显强于普通校验和。
   8           *
   9           * 结构:
  10           *   1) 状态 s[16] 由固定IV初始化;
  11           *   2) 吸收(absorb): 逐字节把输入混入状态, 位置相关, 含加/循环左移/异或;
  12           *   3) 扩散(diffuse): 固定ROUNDS轮的非线性混淆, 每轮更新全部16字节;
  13           *   4) 挤出(squeeze): 逐字节把状态扩散输出, 共16字节。
  14           *
  15           * 代码量约 < 1.2KB。
  16           * ------------------------------------------------------------------ */
  17          
  18          #define FEATTAG_ROUNDS 8   /* 扩散轮数, 越大越安全, 代码量不变仅时间增加 */
  19          
  20          /* 16字节工作状态 */
  21          static uint8_t idata ft_s[16];
  22          
  23          /* 固定初值(IV) */
  24          static const uint8_t code ft_iv[16] = {
  25            0x6A, 0x09, 0xE6, 0x67, 0xBB, 0x67, 0xAE, 0x85,
  26            0x3C, 0x6E, 0xF3, 0x72, 0xA5, 0x4F, 0xF5, 0x3A
  27          };
  28          
  29          /* 8位循环左移 */
  30          #define ROL8(x, n) ((uint8_t)(((uint8_t)(x) << (n)) | ((uint8_t)(x) >> (8 - (n)))))
  31          
  32          void FeatTag_Checksum(const char *in, uint8_t len, uint8_t *out)
  33          {
  34   1        uint8_t i, r, t, a, b;
  35   1      
  36   1        if (len > FEATTAG_MAX_LEN)
  37   1          len = FEATTAG_MAX_LEN;
  38   1      
  39   1        /* 1) 初始化状态 */
  40   1        for (i = 0; i < 16; i++)
  41   1          ft_s[i] = (uint8_t)(ft_iv[i] ^ (uint8_t)(0x9E + i));
  42   1      
  43   1        /* 2) 吸收输入: 每字节混入状态, 并做局部混淆 */
  44   1        for (i = 0; i < len; i++) {
  45   2          t = (uint8_t)in[i] ^ (uint8_t)(i * 0x1D);
