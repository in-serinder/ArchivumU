  47   2          ft_s[(i + 7) & 15] ^= ROL8(t, 3);
  48   2          ft_s[(i + 3) & 15]  = (uint8_t)(ft_s[(i + 3) & 15] + ROL8(ft_s[i & 15], 1));
  49   2        }
  50   1      
  51   1        /* 混入长度, 防止长度扩展/填充歧义 */
  52   1        ft_s[15] ^= (uint8_t)(len + FEATTAG_OUT_LEN);
  53   1      
  54   1        /* 3) 扩散: 固定轮数的非线性混淆, 每轮前向+后向各扫一遍 */
